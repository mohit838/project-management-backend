{
  "name": "project-management-backend",
  "version": "1.0.0",
  "description": "Role based project management with postgres, prisma, typescript, node, express, zod, vitest",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ci": "vitest run",
    "seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.1",
    "ms": "2.1.3",
    "nodemailer": "7.0.12",
    "pg": "8.17.2",
    "prisma": "7.3.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/ms": "2.1.0",
    "@types/node": "25.0.9",
    "@types/nodemailer": "7.0.5",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.8.0",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0",
    "vitest": "4.0.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohit838/project-management-backend.git"
  },
  "keywords": [
    "postgres",
    "prisma",
    "typescript",
    "node",
    "express",
    "zod",
    "vitest"
  ],
  "author": "Mohitul Islam",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mohit838/project-management-backend/issues"
  },
  "homepage": "https://github.com/mohit838/project-management-backend#readme",
  "engines": {
    "node": "22.20.0"
  },
  "packageManager": "pnpm@10.26.2"
}